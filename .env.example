# Camagru — copier ce fichier vers .env puis adapter si besoin.
# Le .env réel est ignoré par git (exigence du sujet).

APP_ENV=dev
APP_URL=http://localhost:8080

# Base de données
DB_HOST=db
DB_PORT=3306
